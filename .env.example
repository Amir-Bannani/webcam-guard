# Telegram Bot Configuration
# 1. Talk to @BotFather to get your TG_BOT_TOKEN
# 2. Start your bot and message it, then run: python guard.py --setup to find your TG_CHAT_ID
TG_BOT_TOKEN=your_telegram_bot_token_here
TG_CHAT_ID=your_telegram_chat_id_here

